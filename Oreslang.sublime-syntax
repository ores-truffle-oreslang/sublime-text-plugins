%YAML 1.2
---
name: Oreslang
file_extensions:
  - ores
  - atto
scope: source.oreslang

variables:
  identifier: '[A-Za-z_][A-Za-z0-9_]*'
  global_controls: '\b(?:recover|defer|throw|raise)\b'
  keywords: '\b(?:abstract|actor|isoactor|critical|suspends|gen|arr|as|block|break|continue|default|loop|nb|over|readch|rt|writech|while|async|await|case|catch|class|conforms|contract|cb|const|def|define|do|done|elif|else|elseif|end|extends|false|fi|finally|fnc|for|from|cpu|gpu|panic|if|impl|implements|import|interface|isolated|let|lex|match|module|mut|namespace|new|null|nlex|obj|of|private|pub|return|routine|select|self|shared|singleton|static|struct|structural|super|switch|then|true|try|type|typeof|val|void|yield|generator|matches|quantum|spawn|stop|trait|trap|types|untrusted)\b'
  builtin_types: '\b(?:any|bool|byte|char|decimal|double|duration|float|float32|float64|int|int8|int16|int32|int64|never|number|string|String|uint|uint8|uint16|uint32|uint64|unknown|usize|isize)\b'

contexts:
  main:
    - include: comments
    - include: strings

    # These are intentionally scoped separately from syntax keywords.
    # The companion color scheme renders them royal blue.
    - match: '{{global_controls}}'
      scope: support.function.global.oreslang

    # Declaration heads keep the declaration keyword in the one canonical
    # Oreslang keyword scope while giving the declared symbol a useful scope.
    - match: '\b(class|module|interface|struct)\s+({{identifier}})'
      captures:
        1: keyword.oreslang
        2: entity.name.type.oreslang
    - match: '\b(fnc|routine)\s+({{identifier}})'
      captures:
        1: keyword.oreslang
        2: entity.name.function.oreslang

    # Compound keywords must match before the ordinary words and minus token.
    - match: '\b(?:critical-read|critical-write|nb-select|transform-pipe)\b'
      scope: keyword.oreslang

    # Hash Symbol literals are distinct from @annotations and strings.
    # Reject raw newlines, invalid escapes, empty names, and >128-byte ASCII hash names.
    # Python/Node static regex checks are not a native Sublime syntax-engine verdict.
    # Decode-free grammar enforces escaped surrogate pairs; NFC, decoded source
    # length, and UTF-8 byte budgets still require authoritative compiler checks.
    - match: '#(?:[A-Za-z_][A-Za-z0-9_]{0,127}(?![A-Za-z0-9_])|"(?:\\(?:u(?:[dD][89aAbB][0-9A-Fa-f]{2}\\u[dD][c-fC-F][0-9A-Fa-f]{2}|(?![dD][89aAbBcCdDeEfF])[0-9A-Fa-f]{4})|["''\\])|[^"\\\r\n])+"|''(?:\\(?:u(?:[dD][89aAbB][0-9A-Fa-f]{2}\\u[dD][c-fC-F][0-9A-Fa-f]{2}|(?![dD][89aAbBcCdDeEfF])[0-9A-Fa-f]{4})|["''\\])|[^''\\\r\n])+'')'
      scope: constant.other.symbol.oreslang

    # ALL language keywords use the exact same scope by design.
    - match: '{{keywords}}'
      scope: keyword.oreslang

    # Pinned Java lexer reserves these comparison operators, including in binding positions.
    - match: '\b(?:eq|neq|is)\b'
      scope: keyword.operator.comparison.oreslang

    - match: '@{{identifier}}'
      scope: storage.type.annotation.oreslang

    - match: '{{builtin_types}}'
      scope: support.type.builtin.oreslang

    - match: '\b(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|[0-9](?:_?[0-9])*(?:\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?i?)\b'
      scope: constant.numeric.oreslang

    - match: '\b({{identifier}})(?=\s*\()'
      scope: variable.function.oreslang

    - match: '=>|->|==|!=|<=|>=|<<|>>>|>>|&&|\|\||[+\-*/%=&|^~!<>?:]'
      scope: keyword.operator.oreslang

    - match: '[{}\[\]()]'
      scope: punctuation.section.oreslang
    - match: '[,.;]'
      scope: punctuation.separator.oreslang

  comments:
    - match: '//'
      scope: punctuation.definition.comment.oreslang
      push:
        - meta_scope: comment.line.double-slash.oreslang
        - match: '$'
          pop: true
    - match: '/\*'
      scope: punctuation.definition.comment.begin.oreslang
      push: block-comment

  block-comment:
    - meta_scope: comment.block.oreslang
    - match: '/\*'
      scope: punctuation.definition.comment.begin.oreslang
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.oreslang
      pop: true

  strings:
    - match: '`'
      scope: punctuation.definition.string.begin.oreslang
      push:
        - meta_scope: string.quoted.template.oreslang
        - match: '\\\\.'
          scope: constant.character.escape.oreslang
        - match: '`'
          scope: punctuation.definition.string.end.oreslang
          pop: true
    - match: '"'
      scope: punctuation.definition.string.begin.oreslang
      push:
        - meta_scope: string.quoted.double.oreslang
        - match: '\\(?:["\\/bfnrt]|u[0-9A-Fa-f]{4})'
          scope: constant.character.escape.oreslang
        - match: '"'
          scope: punctuation.definition.string.end.oreslang
          pop: true
    - match: "'"
      scope: punctuation.definition.string.begin.oreslang
      push:
        - meta_scope: string.quoted.single.oreslang
        - match: "\\\\(?:['\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
          scope: constant.character.escape.oreslang
        - match: "'"
          scope: punctuation.definition.string.end.oreslang
          pop: true
